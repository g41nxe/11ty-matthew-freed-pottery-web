{% if hero.image %}
<section class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-6 pb-12 pt-10 md:flex-row md:pt-16">
    <div class="w-full md:flex-1">
        <p class="cap-label text-blue">{{ hero.eyebrow }}</p>
        <h1 class="mt-3 font-display text-4xl font-black leading-tight text-ink md:text-5xl">{% if hero.highlight and hero.highlight in hero.title %}{{ hero.title | replace(hero.highlight, '<span class="text-sand">' ~ hero.highlight ~ '</span>') | safe }}{% else %}{{ hero.title }}{% endif %}</h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted">{{ hero.text | glazeCount(gallery.items.length) }}</p>
        <div class="mt-7 flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
            <a href="{{ (global.shop.base + global.shop.collectionsPath + "/") | shopLink("hero") }}" target="_blank" rel="noopener" class="btn-primary text-center">{{ hero.cta_primary }}</a>
            <a href="{{ hero.cta_secondary.url }}" class="link-underline self-center">{{ hero.cta_secondary.label }}</a>
        </div>
        {# The line is filled at build time and corrected in the browser by
           events.js, which reads the same cards the events band renders. #}
        {% set next = (events | occurrences | filterUpcoming | nextUp) | first %}
        {% if next %}
        <p id="hero-next" class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
            <span class="h-2 w-2 flex-none rounded-full bg-sand" aria-hidden="true"></span>
            <span class="cap-label text-[11px] text-blue">{{ global.labels.next_market }}</span>
            <span data-hero-next-text class="text-muted">{{ next.date | date("ccc d LLL") }}, {{ next.name }}{% if next.time %}, {{ next.time }}{% endif %}</span>
        </p>
        {% endif %}
    </div>
    <div class="w-full bg-tile md:flex-1">
        {% img hero.image.url, hero.image.alt, "(min-width: 1152px) 532px, (min-width: 768px) 50vw, 100vw", "w-full object-cover", "eager" %}
    </div>
</section>
{% endif %}
