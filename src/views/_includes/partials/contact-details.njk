<h2 class="font-display text-2xl font-black text-ink">{{ social_title }}</h2>

<ul class="mt-4 flex flex-row justify-start gap-4">
    <li>
        <a href="{{ global.socialmedia.services.instagram.url }}" target="_blank" aria-label="Instagram" class="text-muted transition-colors hover:text-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor"/></svg>
        </a>
    </li>
    <li>
        <a href="{{ global.socialmedia.services.facebook.url }}" target="_blank" aria-label="Facebook" class="text-muted transition-colors hover:text-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 8h3V5h-3a4 4 0 0 0-4 4v2H7v3h3v7h3v-7h3l1-3h-4V9a1 1 0 0 1 1-1z"/></svg>
        </a>
    </li>
</ul>

<div class="mt-6 text-base leading-relaxed text-muted">
    {%- for paragraph in intro %}
        <p class="mb-3">{{ paragraph }}</p>
    {%- endfor -%}
</div>

<div class="mt-6">
    <p class="cap-label text-soft">{{ message }}</p>
    <a class="link-underline text-sm" href="mailto:{{ global.contact.email }}">{{ global.contact.email }}</a>
</div>

<div class="mt-6">
    <p class="cap-label text-soft">{{ phone }}</p>
    <a class="link-underline text-sm" href="tel:{{ global.contact.phone }}">{{ global.contact.phone }}</a>
</div>

<div class="mt-6">
    <p class="cap-label text-soft">{{ address }}</p>
    <p class="mt-1 text-base text-muted">{{ global.contact.address | nl2br | safe }}</p>
</div>

{# The map is a picture stored with the site, made from OpenStreetMap by
   scripts/map-preview.mjs, so opening this page contacts no map service
   (ticket 0005). Google Maps is only a link, built from the studio address
   in Settings like the links on the events and retail pages. The picture
   shows only while it was made for the current address, so after a move
   the page never shows the old place; the comparison ignores whitespace
   differences (spacing, line breaks) so an edit that only reformats the
   address does not hide the picture. #}
{% set mapQuery = ('Matthew Freed Pottery, ' ~ global.contact.address) | replace(r/\s*\n\s*/g, ', ') | trim %}
{% set mapsUrl = "https://www.google.com/maps/search/?api=1&query=" ~ (mapQuery | urlencode) %}
{% if (mapPreview.address | replace(r/\s+/g, " ") | trim) == (global.contact.address | replace(r/\s+/g, " ") | trim) %}
<div class="relative mt-6 overflow-hidden rounded-xl bg-tile">
    {# The whole picture is the link to Google Maps. The chip names it, stays
       visible on phones (no hover there) and turns blue on hover or keyboard
       focus while the picture zooms like the shop tiles on the home page. #}
    <a href="{{ mapsUrl }}" target="_blank" rel="noopener" class="group block focus-visible:outline-none" aria-label="{{ global.labels.map_link }}">
        {% img "/images/site/studio-map.png", "Street map around the studio", "(min-width: 1152px) 532px, (min-width: 768px) 50vw, 100vw", "img-zoom block h-[236px] w-full object-cover" %}
        <span class="absolute bottom-2.5 left-2.5 inline-flex items-center gap-1.5 rounded-full border border-hairline bg-white px-3.5 py-1.5 text-sm font-medium text-blue shadow-sm transition-colors duration-300 group-hover:border-blue group-hover:bg-blue group-hover:text-paper group-focus-visible:border-blue group-focus-visible:bg-blue group-focus-visible:text-paper group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-blue">
            {{ global.labels.map_link }}
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6M11 13l9-9M15 4h5v5"/></svg>
        </span>
    </a>
    {# Google-Maps-style pin. The picture is centred on the studio and
       object-cover keeps that centre in the middle of the box (the hover zoom
       scales around it too), so the tip of the pin sits at the centre. It
       ignores clicks, which fall through to the picture link. #}
    <svg class="pointer-events-none absolute left-1/2 top-1/2 h-[43px] w-[27px] -translate-x-1/2 -translate-y-full drop-shadow-sm" viewBox="0 0 27 43" aria-hidden="true" focusable="false">
        <path d="M13.5 0C6.04 0 0 6.04 0 13.5 0 23.6 13.5 43 13.5 43S27 23.6 27 13.5C27 6.04 20.96 0 13.5 0z" fill="#EA4335" stroke="#B31412"/>
        <circle cx="13.5" cy="13.5" r="4.5" fill="#B31412"/>
    </svg>
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener" class="absolute right-2 top-2 bg-paper/90 px-1 py-0.5 text-xs text-ink" aria-label="Map data © OpenStreetMap contributors">© OpenStreetMap contributors</a>
</div>
{% else %}
{# No picture for the current address yet (after a move): a plain link instead. #}
<a href="{{ mapsUrl }}" target="_blank" rel="noopener" class="link-underline mt-6 inline-block text-sm">{{ global.labels.map_link }}</a>
{% endif %}
