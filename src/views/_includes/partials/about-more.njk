{# Cards linking the About pages (About, Art, Process) to each other.
   Picture and text come from each page: its first section image, eyebrow and headline.
   Kept small and as wide as the award note above them. #}
<section class="mx-auto max-w-3xl px-6 pb-14 pt-10" aria-labelledby="about-more-title">
    <h2 id="about-more-title" class="font-display text-2xl font-black text-ink">{{ global.labels.keep_reading | default("Keep reading", true) }}</h2>
    <div class="mt-5 grid grid-cols-2 gap-4 sm:gap-8">
        {% for entry in collections.about | sort(false, true, "url") %}
        {% if entry.url != page.url %}
        {% set cover = entry.data.sections[0].image %}
        <a href="{{ entry.url }}" class="group">
            <div class="aspect-[3/2] w-full overflow-hidden rounded-xl bg-tile">
                {% if cover.url %}{% img cover.url, cover.alt, "(min-width: 768px) 344px, 45vw", "img-zoom h-full w-full object-cover" %}{% endif %}
            </div>
            <p class="cap-label mt-3 text-blue">{{ entry.data.eyebrow | default(entry.data.title) }}</p>
            <h3 class="mt-1 font-display text-base font-black leading-snug text-ink transition-colors group-hover:text-blue sm:text-lg">{{ entry.data.headline }}</h3>
        </a>
        {% endif %}
        {% endfor %}
    </div>
</section>
