<section id="events-band" class="bg-blue" aria-label="Upcoming events">
    <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-display text-3xl font-black text-paper">{{ events_band.title }}</h2>
            <a href="/events.html" class="link-underline link-invert whitespace-nowrap text-sm">{{ events_band.link_label | default("All events", true) }}</a>
        </div>
        {# Every upcoming event is rendered, but only the first four of the
           de-duplicated list start out visible. events.js re-runs that same
           selection in the browser, so a date that passed since the build
           drops out and the one behind it moves up. Without JavaScript the
           build-time selection simply stays. #}
        {% set upcoming = events.events | filterUpcoming | byDateAsc %}
        {% set shortlist = events.events | filterUpcoming | nextUp %}
        {% if upcoming.length %}
        {# Shown by events.js once every rendered date has passed. #}
        <p data-events-soon hidden class="mt-6 max-w-xl text-base text-paper/80">{{ global.labels.dates_soon }}</p>
        <div data-events-grid class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for event in upcoming %}
            {% set rank = shortlist.indexOf(event) %}
            {% set isNext = rank == 0 %}
            <a href="/events.html"
               data-event
               data-date="{{ event.date | date('yyyy-MM-dd') }}"
               data-until="{{ (event.end_date or event.date) | date('yyyy-MM-dd') }}"
               data-name="{{ event.name | trim }}"
               data-hero="{{ event.date | date('ccc d LLL') }}, {{ event.name | trim }}{% if event.time %}, {{ event.time }}{% endif %}"
               {% if rank < 0 or rank > 3 %}hidden{% endif %}
               class="group rounded-xl p-5 transition-colors hover:bg-blue-light {% if isNext %}border-2 border-sand{% else %}border border-blue-light{% endif %}">
                <p data-next-label class="cap-label mb-2 text-[11px] text-sand"{% if not isNext %} hidden{% endif %}>{{ global.labels.next_up }}</p>
                <p class="flex items-baseline gap-2">
                    <span class="font-display text-3xl font-black text-paper">{{ event.date | date("d") }}</span>
                    <span class="cap-label text-[11px] text-sand">{{ event.date | date("MMM") }}</span>
                </p>
                <p class="mt-3 font-display text-base font-black leading-snug text-paper">
                    {{ event.name }}
                </p>
                <p class="mt-1 text-sm text-paper/70">{{ event.location }}</p>
                {% if event.time %}<p class="mt-1 text-sm text-paper/70">{{ event.time }}</p>{% endif %}
                {% if event.atStudio %}<p class="cap-label mt-2 text-[11px] text-sand">{{ global.labels.at_studio }}</p>{% endif %}
            </a>
            {% endfor %}
        </div>
        {% else %}
        <p class="mt-6 max-w-xl text-base text-paper/80">{{ events_band.no_events }}</p>
        {% endif %}
    </div>
    <script defer src="/js/events.js"></script>
</section>
