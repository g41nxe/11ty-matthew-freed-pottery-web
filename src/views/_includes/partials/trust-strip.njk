<section class="border-y border-hairline bg-white" aria-label="Why buy from Matthew">
    {# The track animates by -50% of its own width, so the sequence has to be
       repeated an even number of times for the loop to be seamless. Four
       passes keep the track wider than the viewport up to the lg breakpoint —
       with two, one sequence (880px) is narrower than a 1023px window and a
       gap scrolls into view. Only the first pass is read out. #}
    <div class="trust-marquee py-4 lg:hidden">
        <div class="trust-track">
            {% for pass in [1, 2, 3, 4] %}
            <ul class="trust-seq flex flex-none items-center"{% if pass > 1 %} aria-hidden="true"{% endif %}>
                {% for item in trust %}
                <li class="cap-label mx-3 whitespace-nowrap text-[12px] text-ink">{{ item }}</li>
                <li aria-hidden="true" class="mx-3 text-sand">
                    <svg viewBox="0 0 40 40" width="11" height="11" fill="currentColor"><ellipse cx="20" cy="9" rx="6" ry="9"/><ellipse cx="20" cy="31" rx="6" ry="9"/><ellipse cx="9" cy="20" rx="9" ry="6"/><ellipse cx="31" cy="20" rx="9" ry="6"/></svg>
                </li>
                {% endfor %}
            </ul>
            {% endfor %}
        </div>
    </div>
    <ul class="trust-static mx-auto hidden max-w-6xl flex-col items-center gap-2.5 px-6 py-5 lg:flex lg:flex-row lg:flex-wrap lg:justify-between lg:gap-x-8 lg:gap-y-2">
        {% for item in trust %}
        {% if not loop.first %}
        <li aria-hidden="true" class="text-sand">
            <svg viewBox="0 0 40 40" width="13" height="13" fill="currentColor"><ellipse cx="20" cy="9" rx="6" ry="9"/><ellipse cx="20" cy="31" rx="6" ry="9"/><ellipse cx="9" cy="20" rx="9" ry="6"/><ellipse cx="31" cy="20" rx="9" ry="6"/></svg>
        </li>
        {% endif %}
        <li class="cap-label text-center text-[12px] text-ink">{{ item }}</li>
        {% endfor %}
    </ul>
</section>
