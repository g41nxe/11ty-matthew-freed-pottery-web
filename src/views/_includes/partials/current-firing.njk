{# Every set that is not hidden is rendered, all of them hidden, and the script
   below reveals one at random per page load. They start hidden so the browser
   fetches only the images of the set it ends up showing — an already visible
   section would have its images fetched before the script could hide it again.
   Without JavaScript the first set shows (see the noscript rule). #}
{% set sets = shop_sets | rejectattr("hide") %}
{% for shop_set in sets %}
{% set piece = shop_set.featured_piece %}
<section class="mx-auto max-w-6xl px-6 py-12 hidden" aria-label="From the current firing" data-firing-set{% if loop.first %} data-firing-first{% endif %}>
    <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-3xl font-black text-ink">{{ products.title }}</h2>
        <a href="{{ global.shop.base }}{{ global.shop.collectionsPath }}/" target="_blank" rel="noopener" class="link-underline whitespace-nowrap text-sm">{{ products.link_label | default("Shop all pieces", true) }}</a>
    </div>
    <div class="mt-8 grid gap-10 md:grid-cols-2 lg:gap-12">
        <a href="{{ piece.cta.url }}" target="_blank" rel="noopener" class="group">
            <div class="overflow-hidden bg-tile">
                {% img piece.image.url, piece.image.alt, "(min-width: 1152px) 528px, (min-width: 768px) 50vw, 100vw", "img-zoom w-full object-cover" %}
            </div>
            {% if piece.eyebrow %}<p class="cap-label mt-4 text-[11px] text-sand">{{ piece.eyebrow }}</p>{% endif %}
            <h3 class="mt-1 font-display text-2xl font-black text-ink transition-colors group-hover:text-blue">{{ piece.title }}</h3>
            <p class="cap-label mt-1 text-blue">{{ piece.caption }}</p>
            <p class="mt-3 text-base text-muted">{{ piece.text }}</p>
            {% if piece.price %}<p class="mt-3 font-display text-xl font-black text-ink">{{ piece.price }}</p>{% endif %}
            <span class="btn-outline mt-5">{{ piece.cta.label }}</span>
        </a>
        <div class="grid grid-cols-2 content-start gap-5">
            {% for item in shop_set.items.slice(0, 4) %}
            <a href="{{ item.cta.url }}" target="_blank" rel="noopener" class="group">
                <div class="relative overflow-hidden bg-tile">
                    {% img item.image.url, item.image.alt, "(min-width: 1152px) 254px, (min-width: 768px) 25vw, 50vw", "img-zoom w-full object-cover" %}
                    {% if item.overlay.text %}
                    <div class="absolute inset-x-0 bottom-0 hidden translate-y-3 bg-linear-to-t from-ink via-ink/75 to-transparent px-3 pb-3 pt-12 font-display text-sm leading-snug text-paper opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 md:block">
                        {{ item.overlay.text | safe }}
                    </div>
                    {% endif %}
                </div>
                <div class="mt-2 flex items-baseline justify-between gap-2">
                    <p class="font-display text-sm font-black text-ink transition-colors group-hover:text-blue">{{ item.title.split(" - ")[1] | default(item.title) }}</p>
                    {% if item.price %}<p class="flex-none text-sm font-medium text-muted">{{ item.price }}</p>{% endif %}
                </div>
                <p class="cap-label mt-0.5 text-[10px] text-soft">{{ item.title.split(" - ")[0] }}</p>
                {% if item.overlay.text %}<p class="blurb-inline mt-1.5 text-xs leading-relaxed text-muted md:hidden">{{ item.overlay.text | safe }}</p>{% endif %}
            </a>
            {% endfor %}
        </div>
    </div>
    <p class="mt-6 text-center text-xs text-soft">{{ products.note }}</p>
</section>
{% endfor %}
{% if sets.length %}
{# The sets hide with a class, not the hidden attribute: the browser's own
   rule for [hidden] is !important, so no stylesheet could bring one back. #}
<noscript><style>section[data-firing-first] { display: block !important; }</style></noscript>
{# Inline and right after the sections, so the chosen set is revealed while the
   page is still parsing and nothing jumps into place later. #}
<script>
    (function () {
        var sets = document.querySelectorAll("[data-firing-set]");
        if (!sets.length) return;
        var set = sets[Math.floor(Math.random() * sets.length)];
        set.classList.remove("hidden");
        // A lazy image that was display:none while the page loaded stays
        // unloaded even once its section appears. Setting src again starts
        // that decision over, with the section visible this time.
        var images = set.querySelectorAll("img");
        for (var i = 0; i < images.length; i++) images[i].src = images[i].getAttribute("src");
    })();
</script>
{% endif %}
