---
layout: base
pagination:
  data: glazePages
  size: 1
  alias: glaze
permalink: "{{ glaze.path }}"
eleventyComputed:
  # "Jericho" alone means nothing in a search result, "Jericho glaze" does.
  title: "{{ glaze.name }} glaze"
  # eleventy-plugin-seo reads "excerpt" as the page description (ADR 0002).
  excerpt: "{{ glaze.lead }}"
---
{# One page per glaze, generated from the gallery entries (see
   _data/glazePages.js). The page stays in the site's own palette: paper,
   white and blue. The glaze colour appears only as the dot beside the name,
   the way it does on the cards — a band in the glaze colour would drag
   sixteen foreign colours into the design.

   Order follows what the numbers showed: the pieces sell, so they come
   early, under the full description. A second text block below the pieces
   was tried and dropped — with the same headings on sixteen pages it would
   read as filler. The lead stays a separate field only because the search
   snippet needs two sentences, not the whole text. #}
<article>
    <section class="mx-auto max-w-6xl px-6 pt-12">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-hairline pb-6">
            <div>
                <p class="cap-label text-blue">{{ collections_glaze.eyebrow | default("Glaze", true) }}{% if glaze.group %} &middot; {{ glaze.group }}{% endif %}</p>
                <h1 class="mt-2 flex items-center gap-3 font-display text-4xl font-black leading-tight text-ink">
                    <span class="h-4 w-4 flex-none rounded-full" style="background-color: {{ glaze.swatch }}" aria-hidden="true"></span>
                    {{ glaze.name }}
                </h1>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{{ glaze.lead }}</p>
                {% for paragraph in glaze.paragraphs %}
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{{ paragraph }}</p>
                {% endfor %}
            </div>
            <a href="{{ (global.shop.base + global.shop.collectionsPath + "/" + glaze.slug) | shopLink("glaze-" + glaze.name + "-shop") }}" target="_blank" rel="noopener" class="btn-outline whitespace-nowrap">{{ collections_glaze.shop_cta | default("Shop this glaze", true) }}</a>
        </div>
    </section>

    {% if glaze.set %}
    {% set piece = glaze.set.featured_piece %}
    <section class="mx-auto max-w-6xl px-6 py-10" aria-label="Pieces in this glaze">
        <div class="grid gap-10 md:grid-cols-2 lg:gap-12">
            <a href="{{ piece.cta.url | shopLink("glaze-" + glaze.name + "-featured") }}" target="_blank" rel="noopener" class="group">
                <div class="overflow-hidden bg-tile">
                    {% img piece.image.url, piece.image.alt, "(min-width: 1152px) 528px, (min-width: 768px) 50vw, 100vw", "img-zoom w-full object-cover" %}
                </div>
                {# The set's own text describes the glaze, because on the home
                   page it is the only introduction there is. Here the glaze is
                   already described above, so the piece shows its name, its
                   price and nothing that repeats the first paragraph. #}
                <h2 class="mt-4 font-display text-2xl font-black text-ink transition-colors group-hover:text-blue">{{ piece.title }}</h2>
                {% if piece.price %}<p class="mt-3 font-display text-xl font-black text-ink">{{ piece.price }}</p>{% endif %}
                <span class="btn-outline mt-5">{{ piece.cta.label }}</span>
            </a>
            <div class="grid grid-cols-2 content-start gap-5">
                {% for item in glaze.set.items.slice(0, 4) %}
                <a href="{{ item.cta.url | shopLink("glaze-" + glaze.name + "-tile" + loop.index) }}" target="_blank" rel="noopener" class="group">
                    <div class="relative overflow-hidden bg-tile">
                        {# soldOut comes from _data/soldOut.js, which asks the shop at build time. #}
                        {% if soldOut[item.cta.url] %}<span class="cap-label absolute right-2 top-2 z-10 bg-sand px-2 py-1 text-[10px] font-bold text-ink">{{ global.labels.sold_out | default("Sold out", true) }}</span>{% endif %}
                        {% img item.image.url, item.image.alt, "(min-width: 1152px) 254px, (min-width: 768px) 25vw, 50vw", "img-zoom w-full object-cover" %}
                    </div>
                    <div class="mt-2 flex items-baseline justify-between gap-2">
                        <p class="font-display text-sm font-black text-ink transition-colors group-hover:text-blue">{{ item.title.split(" - ")[1] | default(item.title) }}</p>
                        {% if item.price %}<p class="flex-none text-sm font-medium text-muted">{{ item.price }}</p>{% endif %}
                    </div>
                    {% if item.overlay.text %}<p class="blurb-inline mt-1 text-xs leading-relaxed text-muted">{{ item.overlay.text | safe }}</p>{% endif %}
                </a>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {# Half the tiles can be sold out at any time, and the shop never holds
       everything Matthew has made. Without this the page is a dead end for
       exactly the visitor who wants this glaze most. Wording follows his own
       answers in the FAQ.

       Blue, because on this site blue is the colour of Matthew speaking for
       himself: the events band and the About teaser are the only other two,
       and both are on the home page. This block is him in the first person,
       so it belongs with those and not with the paper and white the shop
       content uses. It also catches the dark bottom edge of the photo above,
       which a white band collided with. #}
    <section class="bg-blue">
        <div class="mx-auto grid max-w-6xl md:grid-cols-2">
            {# The same picture on all sixteen pages, and deliberately so:
               the block is identical everywhere, and a glaze photo here
               would only repeat what the visitor just clicked on. Aligned
               to the top because a centred crop cuts his head off. #}
            <div class="relative aspect-[4/3] overflow-hidden md:aspect-auto">
                {% img "/images/workshop/making-a-batch.jpg", "Matthew Freed at the wheel, the batch he has just thrown drying beside him", "(min-width: 768px) 50vw, 100vw", "absolute inset-0 h-full w-full object-cover object-top" %}
            </div>
            <div class="flex flex-col items-start justify-center px-6 py-12 md:px-12">
                <h2 class="font-display text-2xl font-black text-paper">{{ collections_glaze.ask_title | default("Not in the shop right now?", true) }}</h2>
                <p class="mt-4 max-w-md text-base leading-relaxed text-paper/80">{{ collections_glaze.ask_text | default("I only list pieces I have actually made, so a glaze sells out from time to time. Tell me what you are after in " + glaze.name + " and I will make it and set it aside for you. A commission works the same way: rough dimensions and the glaze line are enough to start.", true) }}</p>
                <a href="/contact.html" class="btn-invert mt-6">{{ collections_glaze.ask_cta | default("Ask about " + glaze.name, true) }}</a>
            </div>
        </div>
    </section>

    {# The field guide is the page we want people to keep circling back to,
       so the other glazes get cards here, not a thin row of links. #}
    <section class="mx-auto max-w-6xl px-6 py-12" aria-label="Other glazes">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-display text-2xl font-black text-ink">{{ collections_glaze.others_title | default("Other glazes", true) }}</h2>
            <a href="/collections.html" class="link-underline whitespace-nowrap text-sm">{{ collections_glaze.back_label | default("All sixteen glazes", true) }}</a>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-5 md:grid-cols-4">
            {% for other in glazePages %}
            {% if other.path != glaze.path %}
            <a href="{{ other.path }}" class="group">
                {# Square, and backed by the glaze colour, the same tile the
                   slider on the home page uses: same job, same shape. #}
                <div class="aspect-[4/3] w-full overflow-hidden" style="background-color: {{ other.swatch }}">
                    {% img other.image.url, other.image.alt, "(min-width: 768px) 25vw, 50vw", "img-zoom h-full w-full object-cover" %}
                </div>
                <p class="mt-3 flex items-center gap-2 font-display text-base font-black text-ink transition-colors group-hover:text-blue">
                    <span class="h-2.5 w-2.5 flex-none rounded-full" style="background-color: {{ other.swatch }}" aria-hidden="true"></span>
                    {{ other.name }}
                </p>
                <p class="mt-1 text-sm text-muted">{{ other.text }}</p>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </section>
</article>
