---
layout: base
pagination:
  data: glazePages
  size: 1
  alias: glaze
  # Without this only the first of the generated pages lands in
  # collections.all, and the sitemap would list one glaze instead of all
  # of them -- on pages built to be found in search, that is the whole
  # point missed.
  addAllPagesToCollections: true
permalink: "{{ glaze.path }}"
eleventyComputed:
  # "Jericho" alone means nothing in a search result, "Jericho glaze" does.
  title: "{{ glaze.name }} glaze"
  # eleventy-plugin-seo reads "excerpt" as the page description (ADR 0002).
  excerpt: "{{ glaze.lead }}"
---
{# One page per glaze, generated from the gallery entries (see
   _data/glazePages.js). The page stays in the site's own palette: paper,
   white and blue. The glaze colour appears only as the dot beside the name,
   the way it does on the cards — a band in the glaze colour would drag
   sixteen foreign colours into the design.

   Order follows what the numbers showed: the pieces sell, so they come
   early, under the full description. A second text block below the pieces
   was tried and dropped — with the same headings on sixteen pages it would
   read as filler. The lead stays a separate field only because the search
   snippet needs two sentences, not the whole text. #}
<article>
    <section class="mx-auto max-w-6xl px-6 pt-12">
        {# One header for every glaze page: label, name, text. The same shape on
           all sixteen, whether or not the glaze has pieces in the shop right
           now. The shop link used to stand here twice, once at the top right
           and once as a button under the text -- both before the visitor had
           seen a single piece. It now belongs to the block that actually shows
           them. #}
        <p class="cap-label text-blue">{{ collections_glaze.eyebrow }}{% if glaze.group %} &middot; {{ glaze.group }}{% endif %}</p>
        <h1 class="mt-2 flex items-center gap-3 font-display text-4xl font-black leading-tight text-ink">
            <span class="h-4 w-4 flex-none rounded-full" style="background-color: {{ glaze.swatch }}" aria-hidden="true"></span>
            {{ glaze.name }}
        </h1>
        <div class="mt-3 border-b border-hairline pb-6">
            <p class="max-w-2xl text-base leading-relaxed text-muted">{{ glaze.lead }}</p>
            {% for paragraph in glaze.paragraphs %}
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{{ paragraph }}</p>
            {% endfor %}
        </div>
    </section>

    {# One shape for all sixteen pages: the glaze on the left, its pieces on
       the right. The picture is Matthew's group photo where he has taken one
       and the glaze's own card otherwise, so no page stands there without a
       picture of itself -- someone arriving from a search has not seen the
       card yet.

       The pieces come from the shop, not from the CMS: a list typed in once
       was stale two months later, with fifteen of twenty tiles sold out while
       the shop held fifty-seven pieces (ADR 0006). A shop set now only says
       which pieces come first. #}
    <section class="mx-auto max-w-6xl px-6 py-12" aria-label="This glaze in the shop">
        {% set shopUrl = (global.shop.base + global.shop.collectionsPath + "/" + glaze.slug) | shopLink("glaze-" + glaze.name + "-shop") %}
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-display text-2xl font-black text-ink">{{ collections_glaze.pieces_title }}</h2>
            <a href="{{ shopUrl }}" target="_blank" rel="noopener" class="link-underline whitespace-nowrap text-sm">{{ collections_glaze.shop_cta_all | replace("{glaze}", glaze.name) }}</a>
        </div>
        <div class="mt-8 grid gap-10 md:grid-cols-2 lg:gap-12">
            <a href="{{ (global.shop.base + global.shop.collectionsPath + "/" + glaze.slug) | shopLink("glaze-" + glaze.name + "-feature") }}" target="_blank" rel="noopener" class="group">
                <div class="overflow-hidden bg-tile">
                    {% img glaze.feature.url, glaze.feature.alt, "(min-width: 1152px) 528px, (min-width: 768px) 50vw, 100vw", "img-zoom w-full object-cover" %}
                </div>
            </a>
            {% if glaze.pieces.length %}
            <div class="grid grid-cols-2 content-start gap-5">
                {% for piece in glaze.pieces %}
                <a href="{{ piece.url | shopLink("glaze-" + glaze.name + "-tile" + loop.index) }}" target="_blank" rel="noopener" class="group">
                    <div class="relative overflow-hidden bg-tile">
                        {# The shop says in the same answer whether a piece is to
                           be had, so no second request is needed for the label. #}
                        {% if not piece.available %}<span class="cap-label absolute right-2 top-2 z-10 bg-sand px-2 py-1 text-[10px] font-bold text-ink">{{ global.labels.sold_out | default("Sold out", true) }}</span>{% endif %}
                        {% img piece.image, piece.alt, "(min-width: 1152px) 254px, (min-width: 768px) 25vw, 50vw", "img-zoom w-full object-cover" %}
                    </div>
                    <div class="mt-2 flex items-baseline justify-between gap-2">
                        <p class="font-display text-sm font-black text-ink transition-colors group-hover:text-blue">{{ piece.title | withoutGlaze(glaze.name) }}</p>
                        {% if piece.price %}<p class="flex-none text-sm font-medium text-muted">{{ piece.price }}</p>{% endif %}
                    </div>
                </a>
                {% endfor %}
            </div>
            {% else %}
            {# Skaha has nothing in the shop at all. The column keeps the shape
               and carries the way there, rather than leaving half the row empty. #}
            <div class="flex items-center">
                <a href="{{ (global.shop.base + global.shop.collectionsPath + "/" + glaze.slug) | shopLink("glaze-" + glaze.name + "-shop-empty") }}" target="_blank" rel="noopener" class="btn-outline">{{ collections_glaze.shop_cta_all | replace("{glaze}", glaze.name) }}</a>
            </div>
            {% endif %}
        </div>
        {# Same line the home page carries under the same pieces: every tile
           here leaves the site, and saying so once under the block is friendlier
           than finding out at the checkout. #}
        {% if collections_glaze.pieces_note and glaze.pieces.length %}<p class="mt-6 text-center text-xs text-soft">{{ collections_glaze.pieces_note }}</p>{% endif %}
    </section>

    {# Half the tiles can be sold out at any time, and the shop never holds
       everything Matthew has made. Without this the page is a dead end for
       exactly the visitor who wants this glaze most. Wording follows his own
       answers in the FAQ.

       Blue, because on this site blue is the colour of Matthew speaking for
       himself: the events band and the About teaser are the only other two,
       and both are on the home page. This block is him in the first person,
       so it belongs with those and not with the paper and white the shop
       content uses. It also catches the dark bottom edge of the photo above,
       which a white band collided with. #}
    <section class="bg-blue">
        <div class="mx-auto grid max-w-6xl md:grid-cols-2">
            {# One picture for all sixteen bands: pots Matthew has thrown and not
               yet glazed. The text beside it offers to make a piece, and the
               picture shows exactly that moment -- a finished, glazed piece
               would argue against the sentence. A per-glaze photo was tried and
               dropped: on two pages it showed a glazed piece under "not in the
               shop right now", and the card image must never appear here at all,
               because the visitor clicked on it to get here. The picture comes
               from Collections - Glaze page in the CMS. #}
            <div class="relative aspect-[4/3] overflow-hidden md:aspect-auto">
                {% img collections_glaze.ask_image.url, collections_glaze.ask_image.alt, "(min-width: 768px) 50vw, 100vw", "absolute inset-0 h-full w-full object-cover" %}
            </div>
            {# Same shape as the About teaser on the home page (story-teaser.njk):
               label, heading, text, action, on the same spacing. Both are
               Matthew speaking in blue, and two blue bands built differently
               would read as two different kinds of thing. #}
            <div class="flex flex-col items-start justify-center px-6 py-12 md:px-12 md:py-14">
                {% if collections_glaze.ask_eyebrow %}<p class="cap-label text-sand">{{ collections_glaze.ask_eyebrow }}</p>{% endif %}
                <h2 class="mt-3 font-display text-3xl font-black leading-tight text-paper">{{ collections_glaze.ask_title }}</h2>
                <p class="mt-4 max-w-md text-base leading-relaxed text-paper/80">{{ collections_glaze.ask_text | replace("{glaze}", glaze.name) }}</p>
                <a href="/contact.html" class="link-underline link-invert mt-8 inline-block text-sm">{{ collections_glaze.ask_cta | replace("{glaze}", glaze.name) }}</a>
            </div>
        </div>
    </section>

    {# The page we want people to keep circling back to, so the other glazes
       get cards here, not a thin row of links. Always four of them, rotating,
       see _data/glazePages.js. #}
    <section class="mx-auto max-w-6xl px-6 py-12" aria-label="Other glazes">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-display text-2xl font-black text-ink">{{ collections_glaze.others_title }}</h2>
            <a href="/collections.html" class="link-underline whitespace-nowrap text-sm">{{ collections_glaze.back_label }}</a>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-5 md:grid-cols-4">
            {% for other in glaze.others %}
            <a href="{{ other.path }}" class="group">
                {# Square, and backed by the glaze colour, the same tile the
                   slider on the home page uses: same job, same shape. #}
                <div class="aspect-[4/3] w-full overflow-hidden" style="background-color: {{ other.swatch }}">
                    {% img other.image.url, other.image.alt, "(min-width: 768px) 25vw, 50vw", "img-zoom h-full w-full object-cover" %}
                </div>
                <p class="mt-3 flex items-center gap-2 font-display text-base font-black text-ink transition-colors group-hover:text-blue">
                    <span class="h-2.5 w-2.5 flex-none rounded-full" style="background-color: {{ other.swatch }}" aria-hidden="true"></span>
                    {{ other.name }}
                </p>
                <p class="mt-1 text-sm text-muted">{{ other.text }}</p>
            </a>
            {% endfor %}
        </div>
    </section>
</article>
