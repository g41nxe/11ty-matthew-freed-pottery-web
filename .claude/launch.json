{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pottery-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8080
    },
    {
      "name": "pottery-serve",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "eleventy:serve"],
      "port": 8080
    },
    {
      "name": "pottery-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/@11ty/eleventy-dev-server/cmd.js", "--dir=dist", "--port=8090"],
      "port": 8090
    }
  ]
}
